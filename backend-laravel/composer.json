{
    "name": "ngalagu/backend-laravel",
    "type": "project",
    "description": "Ngalagu Music Recognition API Backend (Laravel)",
    "keywords": ["laravel", "framework", "audio-recognition", "audd", "spotify"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
